# Agente (obligatoria)
ANTHROPIC_API_KEY=
# Modelo del agente. Por defecto claude-opus-5-5.
DON_GIL_MODEL=claude-haiku-5-5

# WhatsApp por Twilio (demo). El webhook es /api/twilio.
# SID y token solo hacen falta para los avisos de estado que salen del panel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp Cloud API de Meta (número definitivo). El webhook es /api/whatsapp.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
